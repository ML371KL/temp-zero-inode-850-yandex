[Unit]
Description=Яндекс 850 · таймер суточного прогона

[Timer]
# Будни 15:55 UTC = 18:55 МСК, разброс до 2 мин: после основной сессии MOEX
# (закрытие 18:40 МСК, аукцион закрытия — до 18:50) и до вечерней (с 19:05 МСК)
# с разбросом и повтором: старт 18:55–18:57, цена — первым запросом сбора,
# повтор отказавших источников (indicators.collect --retry) — через 60 с после
# первого сбора, ≈ 18:58; до 19:05 остаётся запас на повторы запросов
# (indicators/http.py: паузы 3, 10, 30 с) и установку зависимостей. Перезапуск
# упавшего такта (Restart=on-failure, через 180 с после полного такта) идёт уже
# в вечернюю сессию. Раньше суточного такта соседей (16:40 UTC и позже). ISS отдаёт
# цену закрытия основной сессии и кривую бескупонной доходности этого дня; дата
# прогона по Москве — тот же день. В выходные новых торговых данных нет, и
# прогон дал бы тот же выпуск с новой датой (сторож ждёт до 76 ч: разрыв
# пятница → понедельник — 72 ч).
OnCalendar=Mon..Fri *-*-* 15:55:00 UTC
# Разброс, чтобы не бить по ISS ровно в ту же секунду, что соседние панели;
# не больше 2 мин — иначе повтор сбора подходит к вечерней сессии (аудит 422).
RandomizedDelaySec=120
# Пропущенный из-за выключенной машины прогон догоняется при старте.
Persistent=true
Unit=yandex850-daily.service

[Install]
WantedBy=timers.target
