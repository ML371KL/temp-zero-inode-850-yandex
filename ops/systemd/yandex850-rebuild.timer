[Unit]
Description=Яндекс 850 · таймер проверки нового кода в main (раз в 15 минут)

[Timer]
# Каждые 15 минут на 14-й минуте четверти (решение ведущего, 24.11.2026): мимо
# пересборок соседних панелей (минуты 02, 04, 05, 07, 09, 12 четверти).
# Проверка — один анонимный `git fetch` по HTTPS, секунды. После правки кода
# новый выпуск на витрине — через 15–25 минут плюс сборка GitHub Pages, а не
# вечером.
OnCalendar=*:14,29,44,59
RandomizedDelaySec=60
AccuracySec=30s
# Persistent не нужен: пропущенная проверка ничего не теряет — следующая
# увидит тот же новый код.
Unit=yandex850-rebuild.service

[Install]
WantedBy=timers.target
