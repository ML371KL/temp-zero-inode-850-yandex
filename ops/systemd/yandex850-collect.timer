[Unit]
Description=Яндекс 850 · таймер утреннего сбора

[Timer]
# Ежедневно 06:50 UTC = 09:50 МСК (решение ведущего, 24.11.2026): через
# полчаса после последнего утреннего сбора соседних панелей (06:20 UTC) — ЦБ
# отвечает 403 на плотные серии запросов с одного адреса. Такт собирает живые
# входы (цена ISS, кривая ОФЗ, ключевая ставка ЦБ) — их отдают и позже, этот
# сбор — проверка источников и здоровья до суточного такта. Дата прогона по
# Москве — тот же день. По понедельникам такт ещё и гоняет тесты такта
# «в будущем» (+60 дней).
OnCalendar=*-*-* 06:50:00 UTC
RandomizedDelaySec=300
# Пропущенный из-за выключенной машины прогон догоняется при старте.
Persistent=true
Unit=yandex850-collect.service

[Install]
WantedBy=timers.target
